{
    "geode": "5.11.2",
    "gd": {
        "win": "2.2081",
        "android": "*"
    },
    "id": "lyophi.buffermod",
    "name": "Input Buffer",
    "version": "v1.1.0",
    "developer": "Lyophi",
    "description": "Predictive input buffering for Geometry Dash.",
    "settings": {
        "stage": {
            "type": "string",
            "name": "Main Buffer Window",
            "default": "4 ticks",
            "one-of": ["2 ticks", "4 ticks", "8 ticks", "16 ticks", "Off"]
        },
        "cube-ticks": {
            "type": "int",
            "name": "Cube Window (ticks)",
            "default": -1,
            "min": -1,
            "max": 64
        },
        "ball-ticks": {
            "type": "int",
            "name": "Ball Window (ticks)",
            "default": -1,
            "min": -1,
            "max": 64
        },
        "robot-ticks": {
            "type": "int",
            "name": "Robot Window (ticks)",
            "default": -1,
            "min": -1,
            "max": 64
        },
        "spider-ticks": {
            "type": "int",
            "name": "Spider Window (ticks)",
            "default": -1,
            "min": -1,
            "max": 64
        },
        "ship-ticks": {
            "type": "int",
            "name": "Ship Window (ticks)",
            "default": -1,
            "min": -1,
            "max": 64
        },
        "ufo-ticks": {
            "type": "int",
            "name": "UFO Window (ticks)",
            "default": -1,
            "min": -1,
            "max": 64
        },
        "swing-ticks": {
            "type": "int",
            "name": "Swing Window (ticks)",
            "default": -1,
            "min": -1,
            "max": 64
        },
        "wave-ticks": {
            "type": "int",
            "name": "Wave Window (ticks)",
            "default": -1,
            "min": -1,
            "max": 64
        },
        "wave-mode": {
            "type": "string",
            "name": "Wave Mode",
            "default": "Grid",
            "one-of": ["Min Hold", "Min Gap", "Grid"]
        },
        "dual-mode": {
            "type": "bool",
            "name": "Dual Mode Support",
            "default": false
        },
        "tps-value": {
            "type": "int",
            "name": "Game Speed (TPS)",
            "default": 240,
            "min": 1,
            "max": 10000
        },
        "debug": {
            "type": "bool",
            "name": "Debug Logging",
            "default": false
        }
    }
}
